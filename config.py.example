import os

# === CONFIGURATION ===
organization_url = 'https://dev.azure.com/YOUR_ORG'
personal_access_token = os.getenv('AZURE_DEVOPS_PAT', 'YOUR_PAT_HERE')
project_name = 'YOUR_PROJECT'
repository_name = 'YOUR_REPO'
target_branch = 'YOUR_TARGET_BRANCH'
local_repo_path = 'C:\\PATH\\TO\\YOUR\\REPO'

# === BRANCH CONFIGURATION ===
main_target_branch = 'develop'
check_target_branch = 'release/XX.XX.XX'
cherry_pick_base_branch = 'release/YY.YY.YY'

# === JIRA CONFIGURATION ===
jira_base_url = 'https://YOUR_ORG.atlassian.net/browse/'
jira_email = 'YOUR_EMAIL@company.com'
jira_api_token = 'YOUR_JIRA_TOKEN_HERE'
jira_branched_from_version = 'XX.XX.00'
jira_target_version = 'XX.XX.01'
jira_hotfix_versions = ['XX.XX.01', 'XX.XX.02']

# === SEARCH CRITERIA ===
authors = ['Last, First', 'Last2, First2']
start_date = 'YYYY-MM-DD HH:MM'

# === RELEASE AUDIT (releaseAudit.py) ===
# Independent of the keys above. releaseAudit.py runs the opposite direction
# (what is wrongly PRESENT in a release) and must not disturb the cherry-pick
# configuration, so it uses its own namespaced keys.
# Versions are compared numerically, so older/newer is derived rather than
# enumerated. Anything targeting a LATER release than audit_target_version is
# reported as a stray.
audit_release_branch = 'release/XX.XX.XX'           # the branch under audit
audit_previous_release_branch = 'release/WW.WW.WW'  # the release it branched after
audit_target_version = 'ProductName XX.XX.00'       # what this branch is meant to ship
audit_extra_expected_versions = []                  # escape hatch for odd version names
audit_jira_projects = ['ABC']                       # project keys to match in commit msgs
